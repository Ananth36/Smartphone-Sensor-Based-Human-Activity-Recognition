# ---------- Data (large; rebuilt by 01_HAR_Preprocessing.ipynb) ----------
Dataset/
dataset/
*.zip

# processed/: ignore the big arrays, keep the small json files
# (meta.json carries dataset_version; scaler + feature-name files are tiny)
processed/*.npz
processed/*.joblib
processed/*.pkl

